rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{id} {
      allow read, write: if false;
    }

    match /entitlements/{email} {
      allow read, write: if false;
    }

    match /vaultObjects/{vaultId}/items/{objectId} {
      allow read, write: if false;
    }
  }
}
